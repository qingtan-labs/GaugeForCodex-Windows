<Window x:Class="GaugeForCodex.QuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gauge for Codex · Windows" Width="304" MinHeight="148" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        Topmost="False" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#12251A"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="6"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Hit" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#14304435"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="#23304435"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Hit" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Card" BorderBrush="#B0FFFFFF" BorderThickness="1"
          CornerRadius="16" Padding="16,11,16,10" Cursor="Arrow"
          MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseLeftButtonUp">
    <StackPanel>
      <Grid Cursor="SizeAll" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox x:Name="BrandMark" Width="19" Height="19" Margin="0,0,7,0" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
              <Path Stroke="{Binding Foreground, ElementName=TitleLabel}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M18,6 A8.5,8.5 0 1 0 18,18"/>
              <Path Stroke="{Binding Foreground, ElementName=TitleLabel}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M8.5,8.5 L12,12 L8.5,15.5 M15,15.5 H18.5"/>
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="TitleLabel" Text="Codex 额度" Foreground="#12251A" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="PeriodName" Grid.Column="1" Foreground="#12251A" FontSize="10.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <Button x:Name="MenuButton" Grid.Column="2" Content="⋯" FontSize="16" Click="MenuButton_Click" ToolTip="菜单"/>
        <Button x:Name="HideButton" Grid.Column="3" Click="HideButton_Click" ToolTip="隐藏到托盘">
          <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="#12251A" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
        </Button>
      </Grid>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="Remaining" Text="—" Foreground="#12251A" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="RemainingCaption" Text="剩余额度" Foreground="#12251A" FontSize="11.5" FontWeight="Medium" Margin="7,0,0,3" VerticalAlignment="Bottom" TextWrapping="Wrap" MaxWidth="105"/>
        </StackPanel>
        <TextBlock x:Name="UsedLabel" Grid.Column="1" Foreground="#12251A" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
      </Grid>
      <Grid x:Name="ProgressTrack" Height="4" SizeChanged="ProgressTrack_SizeChanged">
        <Border Background="#14293D32" CornerRadius="2"/>
        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Background="#537F6A" CornerRadius="2"/>
      </Grid>
      <TextBlock x:Name="ResetLine" Text="右键可手动填写" Foreground="#12251A" FontSize="11.5" FontWeight="Medium" Margin="0,9,0,4" TextWrapping="Wrap"/>
      <TextBlock x:Name="OtherQuotaWarning" Visibility="Collapsed" Foreground="#3D170F" FontSize="11.5" FontWeight="Medium"
                 Margin="0,2,0,5" TextWrapping="Wrap"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SourceLine" Foreground="#12251A" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap"/>
        <Button x:Name="DetailsButton" Grid.Column="1" Width="Auto" MinWidth="72" Height="27" Padding="7,4" Click="DetailsButton_Click"
                AutomationProperties.Name="{Binding Text, ElementName=DetailsLabel}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="DetailsLabel" Text="查看详情" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
            <Path x:Name="DetailsChevron" Data="M2,4 L6,8 L10,4" Stroke="#12251A" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
      <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,7,0,0">
        <StackPanel x:Name="PeriodRows"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
